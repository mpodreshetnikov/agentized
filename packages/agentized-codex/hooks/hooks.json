{
  "description": "Agentized Codex hooks (NAV reminder, claim guard, warn-only leases, git-hooks self-heal).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/session_start.py\"",
            "statusMessage": "Agentized NAV check",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/process_guard.py\"",
            "statusMessage": "Agentized process guard",
            "additionalContextLimit": 5000
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/lease_warn.py\"",
            "statusMessage": "Agentized lease warn",
            "additionalContextLimit": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/ensure_agent_hooks.py\"",
            "statusMessage": "Agentized git-hooks self-heal",
            "additionalContextLimit": 2000
          }
        ]
      }
    ]
  }
}