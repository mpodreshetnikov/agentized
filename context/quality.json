{
  "version": 1,
  "coverage": {
    "lines": 80,
    "branches": 80
  },
  "modules": [
    {
      "id": "runtime",
      "source": [
        "runtime/agentized"
      ],
      "test_command": "python3 -m pytest tests/unit tests/quality -q --cov=runtime/agentized --cov-branch --cov-report=term-missing --cov-report=lcov:coverage/runtime/lcov.info --cov-report=json:coverage/runtime/coverage.json --cov-fail-under=0",
      "coverage_lcov": "coverage/runtime/lcov.info",
      "coverage_json": "coverage/runtime/coverage.json",
      "thresholds": {}
    }
  ],
  "mutation": {
    "enabled": true,
    "tool": "mutmut",
    "gate": "hard",
    "scope": "covered_changed_lines",
    "base_ref": "origin/main",
    "min_score_covered": 100,
    "break_on_survived": true,
    "break_on_no_tests": true,
    "include_globs": [
      "runtime/agentized/*.py"
    ]
  },
  "test_smells": {
    "enabled": true,
    "mode": "hard",
    "include_globs": [
      "tests/unit/**/*.py",
      "tests/quality/**/*.py"
    ]
  },
  "architecture": {
    "enabled": true,
    "mode": "hard",
    "tool": "import-linter",
    "config": ".importlinter",
    "source_roots": [
      "runtime/agentized"
    ],
    "forbidden_edges": [
      {
        "from": "agentized.coverage_report",
        "to": "agentized.connect"
      },
      {
        "from": "agentized.mutation",
        "to": "agentized.connect"
      }
    ]
  },
  "property_based": {
    "enabled": true,
    "tools": {
      "python": "hypothesis",
      "javascript": "fast-check"
    },
    "pilot_modules": [
      "runtime/agentized/paths.py"
    ]
  },
  "e2e": {
    "enabled": "auto",
    "mode": "hard",
    "base_ref": "origin/main",
    "require_tests_for_changed": true,
    "source_globs": [
      "app/**",
      "src/**",
      "pages/**",
      "components/**",
      "web/**",
      "frontend/**",
      "ui/**",
      "client/**"
    ],
    "test_globs": [
      "e2e/**",
      "tests/e2e/**",
      "cypress/e2e/**",
      "playwright/**",
      "**/*.e2e.ts",
      "**/*.e2e.js",
      "**/*.e2e.tsx"
    ],
    "test_command": null,
    "on_failure_artifacts": [
      "video",
      "screenshot"
    ],
    "new_spec_retries": 3,
    "forbid": [
      "pixel_compare",
      "snapshot_markup",
      "formal_contracts"
    ]
  },
  "db_tests": {
    "enabled": "auto",
    "mode": "hard",
    "base_ref": "origin/main",
    "require_tests_for_changed": true,
    "source_globs": [
      "**/migrations/**",
      "**/db/migrations/**",
      "**/alembic/versions/**",
      "**/prisma/migrations/**",
      "**/supabase/migrations/**",
      "db/**/*.sql",
      "sql/**",
      "schema.sql",
      "**/schema/**"
    ],
    "test_globs": [
      "**/tests/db/**",
      "**/db/tests/**",
      "**/pgtap/**",
      "**/test_*.sql",
      "**/*_test.sql",
      "tests/sql/**"
    ],
    "test_command": null
  },
  "shared_fixtures": {
    "required_when_duplicated_logic": true
  },
  "batch_release": {
    "shared_ci_for_reviewed_prs": true,
    "keep_up_to_date_protection": true
  },
  "gates": {
    "pre_push": [
      "mechanical",
      "module_tests",
      "coverage",
      "test_smells",
      "architecture",
      "e2e",
      "db_tests",
      "mutation"
    ],
    "ci": [
      "mechanical",
      "module_tests",
      "coverage",
      "test_smells",
      "architecture",
      "e2e",
      "db_tests",
      "mutation"
    ]
  },
  "reviewer": {
    "enabled": true,
    "helper_model": "composer-2",
    "budget_max": 3,
    "delta_lines": 200,
    "harnesses": {
      "cursor": {
        "model": "grok-4.7[reasoning_effort=medium]",
        "effort": "medium"
      },
      "claude": {
        "model": "claude-fable-5-2",
        "effort": "medium"
      },
      "codex": {
        "model": "gpt-6-astra",
        "effort": "medium"
      }
    },
    "sensitive_globs": [
      "runtime/**",
      "packages/shared/**",
      ".github/workflows/**",
      ".githooks/**",
      "context/quality.json",
      "context/process-control.json",
      "context/env-check.json",
      "AGENTS.md",
      "docs/QUALITY.md",
      "docs/process-control.md"
    ]
  }
}
