#!/usr/bin/env bash
# AGENTIZED:QUALITY — hard status gates on context/tasks before commit.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"

if [[ -x ./bin/agentized ]]; then
  CLI=(./bin/agentized)
elif [[ -f runtime/agentized_cli.py ]]; then
  CLI=(python3 runtime/agentized_cli.py)
elif command -v agentized >/dev/null 2>&1; then
  CLI=(agentized)
else
  echo "[agentized pre-commit] ERROR: agentized CLI not found" >&2
  exit 1
fi

echo "[agentized pre-commit] tasks-validate (status gates)"
"${CLI[@]}" tasks-validate

echo "[agentized pre-commit] OK"
