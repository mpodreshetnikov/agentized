.agentized/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.coverage
coverage/
htmlcov/
mutants/
.mutmut-cache/
reports/mutation/
# Ephemeral mutmut import-path bridge (created by runtime/agentized/mutation.py)
/agentized
# Generated harness wiring from `agentized connect` (re-created locally).
# Pinned SoT remains under context/skills and context/hooks.
# Track project hooks + reviewer agents so env-check / self-heal work without
# a fresh connect (skills stay local-only).
.cursor/*
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/**
!.cursor/agents/
!.cursor/agents/reviewer.md
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
!.claude/agents/
!.claude/agents/reviewer.md
.codex/*
!.codex/hooks.json
!.codex/hooks/
!.codex/hooks/**
!.codex/agents/
!.codex/agents/reviewer.toml
.agents/skills/
