/**
 * JS/TS mutation template (Stryker). Hard gate is enforced by
 * run-mutation-js.cjs.example on mutationScoreCovered = 100% from JSON —
 * do not rely on thresholds.break (overall mutationScore).
 *
 * Copy into a JS/TS workspace; Agentized itself uses mutmut (Python).
 */
/** @type {import('@stryker-mutator/api/core').PartialStrykerOptions} */
const config = {
  packageManager: "npm",
  testRunner: "vitest",
  plugins: ["@stryker-mutator/vitest-runner"],
  mutate: ["src/**/*.{ts,tsx,js,mjs,cjs}", "!**/*.{test,spec}.{ts,tsx,js}"],
  ignoreStatic: true,
  reporters: ["clear-text", "progress", "json", "html"],
  jsonReporter: { fileName: "reports/mutation/mutation.json" },
  htmlReporter: { fileName: "reports/mutation/mutation.html" },
  // Informational only — real hard gate = mutationScoreCovered via wrapper.
  thresholds: {
    high: 100,
    low: 100,
    break: null,
  },
  timeoutMS: 60_000,
  concurrency: 4,
  cleanTempDir: true,
};

export default config;
